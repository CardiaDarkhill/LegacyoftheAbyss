<Project Sdk="Microsoft.NET.Sdk">

  <!-- 
  Imports silksong path properties only if present in order to allow CI builds. The file should be gitignored.
  If you are checking out from git and need to create a new one, you can use `dotnet new silksongpath` to generate one.
  -->
  <Import Condition="Exists('SilksongPath.props')" Project="SilksongPath.props" />

  <!--
  Local-only, gitignored (see DevProfile.props). Supplies ModManagerProfileFolder for the
  DeployDevProfile target below. Absent on CI and on any checkout that does not use a mod manager.
  -->
  <Import Condition="Exists('DevProfile.props')" Project="DevProfile.props" />

  <PropertyGroup>
    <!--
    Launching through the mod manager and launching Steam directly load from two different
    BepInEx trees, and a dev build that only lands in one of them is how a "why is my change not
    showing up" session starts. So DeployLocalDevBuild implies DeployDevProfile whenever a
    profile is actually configured - one command, both destinations.

    DeployDevProfileExplicit remembers whether the profile deploy was asked for by name. An
    explicit -p:DeployDevProfile=true is a direct instruction and still hard-errors when the
    profile cannot be found; the implied one only warns and skips, so renaming a profile in the
    manager does not start failing every local build.
    -->
    <DeployDevProfileExplicit>$(DeployDevProfile)</DeployDevProfileExplicit>
    <DeployDevProfile Condition="'$(DeployDevProfile)' == '' AND '$(DeployLocalDevBuild)' == 'true' AND '$(ModManagerProfileFolder)' != ''">true</DeployDevProfile>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RestoreAdditionalProjectSources>
        https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
	  <!--Allow access of private members at runtime.-->
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--Catch dead code, redundant allocations and unnecessary reflection at build time.
        Individual rule severities live in .editorconfig.-->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!--These properties will control the generated PluginInfo. Version is also used by various parts of the build system.-->
    <BepInExPluginGuid>legacyoftheabyss</BepInExPluginGuid>
    <BepInExPluginName>legacyoftheabyss</BepInExPluginName>
    <Version>$(Version)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <DistributionVersion Condition="'$(DistributionVersion)' == ''">$(Version)</DistributionVersion>
    <PackageBaseName Condition="'$(PackageBaseName)' == ''">$(AssemblyName)</PackageBaseName>
    <PackageBaseName Condition="'$(PackageBaseName)' == ''">$(MSBuildProjectName)</PackageBaseName>
    <ReleasePackagingRoot>$(MSBuildProjectDirectory)/obj/$(Configuration)</ReleasePackagingRoot>
    <NexusPackageRoot>$(ReleasePackagingRoot)/Nexus/$(PackageBaseName)-$(DistributionVersion)</NexusPackageRoot>
    <!--
    Deliberately NOT versioned, unlike NexusPackageRoot above. thunderstore.toml's
    [[build.copy]] source has to name this folder literally, and tcli silently produces an
    empty package when that path does not exist (no error, exit code 0) - which is exactly how
    a DLL-less zip got built. A static path means the toml never has to be rewritten per
    release, so local `tcli build` and CI use the identical, always-valid config. The version
    still reaches the package via manifest.json and tcli's package-version flag.
    -->
    <ThunderstorePackageRoot>$(ReleasePackagingRoot)/Thunderstore/$(PackageBaseName)</ThunderstorePackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
    <!--If you're unable resolve this dependency, check that you're using the nuget v3 package feed instead of v2.-->
    <PackageReference Include="Silksong.GameLibs" Version="1.0.2-silksong1.0.28561"/>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\charm_placements.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\obj\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <Compile Remove="**\Decompiles\**\*.cs" />
  </ItemGroup>

  <Target Name="CopyMod" AfterTargets="PostBuildEvent" Condition="'$(SilksongFolder)' != ''">
      <ItemGroup>
          <Binaries Include="$(TargetPath)"/>
          <Binaries Include="$(TargetDir)/$(TargetName).pdb"/>
          <ModAssets Include="Assets\charm_placements.json" />
      </ItemGroup>

      <Copy SourceFiles="@(Binaries)" DestinationFolder="$(SilksongFolder)/BepInEx/plugins/$(TargetName)" />
      <MakeDir Directories="$(SilksongFolder)/BepInEx/plugins/$(TargetName)/Assets" />
      <Copy SourceFiles="@(ModAssets)" DestinationFolder="$(SilksongFolder)/BepInEx/plugins/$(TargetName)/Assets" SkipUnchangedFiles="true" />

      <PropertyGroup>
          <ExportFolder>bin/Publish</ExportFolder>
      </PropertyGroup>

      <RemoveDir Directories="$(IntermediateOutputPath)/archive"/>
      <MakeDir Directories="$(ExportFolder)"/>
      <Copy SourceFiles="@(Binaries)" DestinationFolder="$(IntermediateOutputPath)/archive"/>
      <MakeDir Directories="$(IntermediateOutputPath)/archive/Assets" />
      <Copy SourceFiles="@(ModAssets)" DestinationFolder="$(IntermediateOutputPath)/archive/Assets" />
      <ZipDirectory SourceDirectory="$(IntermediateOutputPath)/archive" DestinationFile="$(ExportFolder)/$(TargetName).zip" Overwrite="True"/>
  </Target>

  <!--
  Local dev convenience only — distinct from CopyMod above. CopyMod deploys into a
  self-contained BepInEx/plugins/<name>/ subfolder, which is the portable layout a real
  end-user following the README/Thunderstore instructions expects. This target instead copies
  flat, directly into BepInEx/plugins/, one level above this project — the layout this
  particular local install has historically used, where the shipped Assets/ (and this
  install's save data) sit alongside the dll rather than in this repo's own Assets/ folder.
  Opt-in via a property so a plain `dotnet build` never touches the live game folder by
  accident. Usage: dotnet build -c Release -p:DeployLocalDevBuild=true

  This also triggers DeployDevProfile below when DevProfile.props supplies a profile path, so one
  command updates both the game folder and the mod manager profile.
  -->
  <Target Name="DeployLocalDevBuild" AfterTargets="Build" Condition="'$(DeployLocalDevBuild)' == 'true'">
      <ItemGroup>
          <LocalDevBinaries Include="$(TargetPath)" />
          <LocalDevBinaries Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      </ItemGroup>
      <Copy SourceFiles="@(LocalDevBinaries)" DestinationFolder="$(MSBuildProjectDirectory)\.." SkipUnchangedFiles="false" />
      <Message Text="Deployed local dev build to $(MSBuildProjectDirectory)\.." Importance="High" />
  </Target>

  <!--
  Deploys this build into a Thunderstore Mod Manager / r2modman profile so the in-development plugin
  runs next to manager-installed debug mods (DebugMod, FsmMaster, ...). Launching through the manager
  overrides doorstop's target assembly to the *profile's* BepInEx, so the game folder's
  BepInEx/plugins tree - where this repo lives - is never scanned on those launches; without this
  target the only Legacy build the profile can see is the published Thunderstore package.

  Deploys into its own LegacyoftheAbyss-Dev folder rather than over the managed
  CardiaDarkhill-LegacyoftheAbyss package: the manager owns package folders and rewrites them on
  update/enable/disable, whereas unmanaged folders (absent from the profile's mods.yml) are left
  alone. Keep the published package DISABLED in that profile - two copies share one BepInPlugin GUID
  and only one will load, with no guarantee which.

  Assets/ inside the deploy folder is a directory junction to the game folder's
  BepInEx/plugins/Assets, matching ModPaths.Assets (resolved next to the DLL), so sprites and audio
  stay single-sourced instead of being duplicated per profile.

  Runs automatically as part of -p:DeployLocalDevBuild=true (see the PropertyGroup near the top of
  this file), so the ordinary dev-build command covers both launch paths. Pass
  -p:DeployDevProfile=true on its own to deploy to the profile only, or
  -p:DeployDevProfile=false alongside DeployLocalDevBuild to opt back out.
  -->
  <Target Name="DeployDevProfile" AfterTargets="Build" Condition="'$(DeployDevProfile)' == 'true'">
      <Error Condition="'$(DeployDevProfileExplicit)' == 'true' AND '$(ModManagerProfileFolder)' == ''"
             Text="DeployDevProfile requires ModManagerProfileFolder. Create DevProfile.props next to this csproj and set it to the mod manager profile folder." />
      <Error Condition="'$(DeployDevProfileExplicit)' == 'true' AND '$(ModManagerProfileFolder)' != '' AND !Exists('$(ModManagerProfileFolder)')"
             Text="Mod manager profile folder not found: $(ModManagerProfileFolder). Check the path in DevProfile.props - profiles are renamed and deleted from inside the manager." />
      <Warning Condition="'$(DeployDevProfileExplicit)' != 'true' AND !Exists('$(ModManagerProfileFolder)')"
               Text="Skipping the mod manager profile deploy: $(ModManagerProfileFolder) does not exist. Update the path in DevProfile.props - profiles are renamed and deleted from inside the manager." />

      <PropertyGroup>
          <DevProfilePluginFolder Condition="Exists('$(ModManagerProfileFolder)')">$(ModManagerProfileFolder)\BepInEx\plugins\$(TargetName)-Dev</DevProfilePluginFolder>
      </PropertyGroup>

      <ItemGroup>
          <DevProfileBinaries Include="$(TargetPath)" />
          <DevProfileBinaries Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      </ItemGroup>

      <MakeDir Condition="'$(DevProfilePluginFolder)' != ''" Directories="$(DevProfilePluginFolder)" />
      <Copy Condition="'$(DevProfilePluginFolder)' != ''" SourceFiles="@(DevProfileBinaries)" DestinationFolder="$(DevProfilePluginFolder)" SkipUnchangedFiles="false" />
      <Warning Condition="'$(DevProfilePluginFolder)' != '' AND !Exists('$(DevProfilePluginFolder)\Assets')"
               Text="No Assets folder at $(DevProfilePluginFolder)\Assets - the mod will fall back to its other search roots and may not find sprites or audio. Recreate the junction: mklink /J &quot;$(DevProfilePluginFolder)\Assets&quot; &quot;&lt;game&gt;\BepInEx\plugins\Assets&quot;" />
      <Message Condition="'$(DevProfilePluginFolder)' != ''" Text="Deployed dev build to mod manager profile: $(DevProfilePluginFolder)" Importance="High" />
  </Target>

  <!--
  Opt-in only: unlike CopyMod, this target had no gate beyond Configuration==Release, so every
  plain `dotnet build -c Release` (including test/verification builds) silently staged a fresh,
  independently-loadable copy of the plugin under obj/Release/Nexus and obj/Release/Thunderstore.
  Since obj/ sits inside the live BepInEx/plugins tree, BepInEx's recursive plugin scan picked
  these up as genuine duplicates and (because the BepInPlugin version string below never changes)
  had no reliable way to prefer the actual latest build over a stale one. Pass
  -p:CreateDistributionPackages=true when you actually want to cut a release.
  -->
  <Target Name="PrepareReleasePackages" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(CreateDistributionPackages)' == 'true'">
    <ItemGroup>
      <PluginBinary Include="$(TargetPath)" Condition="Exists('$(TargetPath)')" />
      <PluginDeps Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
      <!--
      Assets\logs\ is the mod's own runtime damage-log output, written next to the sprites it
      loads. It is gitignored, so a CI checkout only ever has the .gitkeep - but a local build
      packages whatever that folder happens to contain, which meant the manual-fallback zip
      shipped the maintainer's old debug logs. Exclude them from the glob so both paths agree.
      -->
      <AssetFiles Include="Assets\**\*.*" Exclude="Assets\logs\**\*.*" />
    </ItemGroup>

    <Message Text="Packaging Nexus and Thunderstore releases for version $(DistributionVersion)." Importance="High" />

    <RemoveDir Directories="$(NexusPackageRoot)" Condition="Exists('$(NexusPackageRoot)')" />
    <RemoveDir Directories="$(ThunderstorePackageRoot)" Condition="Exists('$(ThunderstorePackageRoot)')" />

    <MakeDir Directories="$(NexusPackageRoot)/BepInEx/plugins" />
    <Copy SourceFiles="@(PluginBinary)" DestinationFolder="$(NexusPackageRoot)/BepInEx/plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(NexusPackageRoot)/BepInEx/plugins/Assets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <MakeDir Directories="$(ThunderstorePackageRoot)" />
    <Copy SourceFiles="@(PluginBinary)" DestinationFolder="$(ThunderstorePackageRoot)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginDeps)" DestinationFolder="$(ThunderstorePackageRoot)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(ThunderstorePackageRoot)/plugins/Assets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!--
    manifest.json, README.md and icon.png are deliberately NOT staged here. tcli supplies all
    three itself - the manifest generated from thunderstore.toml, the other two from [build]
    icon/readme - and staging a second copy made tcli log
    "<file> was added multiple times to the build and will be overwritten" for each. Those
    warnings are not cosmetic: tcli exits 1 on them, which failed the publish workflow at the
    build step even though the zip it produced was perfectly valid. Leaving tcli as the sole
    source of package metadata also removes the chance of thunderstore.toml and a separate
    manifest template drifting apart.
    -->
  </Target>
</Project>
